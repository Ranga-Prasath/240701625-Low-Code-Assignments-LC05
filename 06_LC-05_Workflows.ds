 application "Recruitment and Job Application Management LC-05"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Employees
		{
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Department
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Name
			(
    			type = name
				displayname = "Employee Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Application_Form
		{
			displayname = "Job Application Form"
			success message = "Job Application Added Successfully"
			Section
			(
				type = section
				displayname = "Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Candidate_Name
			(
    			type = name
				displayname = "Candidate Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Previous_Employment_History
			(
				type = grid
				displayname = "Previous Employment History"
				Company_Name
				(
    				type = text
					displayname = "Company Name"
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
				Duration_Years
				(
					type = number
					displayname = "Duration Years"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Current_Address
			(
    			type = address
				displayname = "Current Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Candidate_Photo
			(
    			type = image
				displayname = "Candidate Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Contact_and_Online_Presence
			(
				type = section
				displayname = "Contact and Online Presence"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				displayname = "Email Address"
	 			row = 7
	 			column = 1   
				width = medium
			)
			LinkedIn_Profile
			(
    			type = text
				displayname = "LinkedIn Profile"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Portfolio_GitHub_URL
			(
    			type = url
				displayname = "Portfolio GitHub URL"
				enable  linkname
	 			row = 9
	 			column = 1   
				width = medium
			)
			Job_and_Experience_Details
			(
				type = section
				displayname = "Job and Experience Details"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			must have Department_Applied_For
			(
				type = picklist
				displayname = "Department Applied For"
				values = {"Software Development","Data Science","Human Resources","Marketing","Finance","Operations"}
	 			row = 11
	 			column = 1   
				width = medium
			)
			must have Employment_Type_Preferred
			(
				type = radiobuttons
				displayname = "Employment Type Preferred"
				maxchar = 100
				values = {"Full-Time","Part-Time","Internship"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Years_Of_Experience
			(
				type = number
				displayname = "Years Of Experience"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Key_Skills
			(
				type = list	
				displayname = "Key Skills"
				values = {"Java","React","SQL","Communication"}
				height = 60px
	 			row = 14
	 			column = 1   
				width = medium
			)
			Academic_CGPA
			(
				type = decimal
				displayname = "Academic CGPA"
	 			row = 15
	 			column = 1   
				width = medium
			)
			Willing_To_Relocate
			(
    			type = checkbox
				displayname = "Willing To Relocate"
				initial value = false
	 			row = 16
	 			column = 1   
				width = medium
			)
			Referral_Employee_Lookup
			(
				type = picklist	
				displayname = "Referral Employee Lookup"
				values  = Employees.ID
    			displayformat = [" " + Employee_Name.prefix + " " + Employee_Name.first_name + " " + Employee_Name.last_name + " " + Employee_Name.suffix]
				sortorder = ascending
	 			row = 17
	 			column = 1   
				width = medium
			)
			Current_Annual_CTC
			(
				displayname = "Current Annual CTC"
				type = INR
				format = commadotindian
	 			row = 18
	 			column = 1   
				width = medium
			)
			Expected_Salary_Hike_Percent
			(
    			type = percentage
				displayname = "Expected Salary Hike Percent"
	 			row = 19
	 			column = 1   
				width = medium
			)
			Expected_Annual_CTC
			(
				type = decimal
				displayname = "Expected Annual CTC"
	 			row = 20
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Current_Annual_CTC + input.Current_Annual_CTC * input.Expected_Salary_Hike_Percent / 100
    						visibility = true
    			)
			)
			Available_Joining_Date
			(
    			type = date
				displayname = "Available Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 21
	 			column = 1   
				width = medium
			)
			Interview_Scheduling_and_Consent
			(
				type = section
				displayname = "Interview Scheduling and Consent"
				visibility = true
	 			row = 22
	 			column = 0   
				width = medium
			)
			Preferred_Interview_Time
			(
    			type = time
				displayname = "Preferred Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 23
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				displayname = "Cover Letter"
				height = 13px
	 			row = 24
	 			column = 1   
				width = medium
			)
			Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive
	 			row = 25
	 			column = 1   
				width = medium
			)
			Self_Introduction_Audio
			(
     			type = audio
				displayname = "Self Introduction Audio"
    			duration=60
	 			row = 26
	 			column = 1   
				width = medium
			)
			Video_Resume
			(
    			type = video
				displayname = "Video Resume"
    			duration=30
	 			row = 27
	 			column = 1   
				width = medium
			)
			Candidate_Digital_Signature
			(
    			type = signature
				displayname = "Candidate Digital Signature"
	 			row = 28
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Background_Verification_Consent
			(
				type = checkboxes	
				displayname = "Background Verification Consent"
				values = {"I consent to background verification if selected"}
	 			row = 29
	 			column = 1   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 30
	 			column = 1   
				width = medium
			)
			Application_Submitted_On
			(
    			type = datetime
				displayname = "Application Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 31
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Candidate Tracking QR Code"
				value = "${Application_ID}"
	 			row = 32
	 			column = 1   
				width = medium
			)
			Company_Culture_Display
			(
    			type = richtext
				displayname = "Company Culture Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 33
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
